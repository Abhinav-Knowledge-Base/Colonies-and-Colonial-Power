---
import Layout from '../layouts/Layout.astro';
import { getGuideRaw } from '../lib/episodes';
import { parseMarkdown } from '../lib/markdown';
import { withBase } from '../lib/base';

const raw = getGuideRaw();
const { html, toc } = parseMarkdown(raw);
---

<Layout
  title="Production Guide & Handbook — Colonies and Colonial Power"
  description="Filming rules, camera grammar, audio design, pacing, archival clearance, and honesty rules for Colonies and Colonial Power."
  activeNav="guide"
>
  <div class="container" style="padding-top: 40px; padding-bottom: 80px;">
    <!-- Breadcrumb -->
    <nav style="display: flex; gap: 8px; font-size: 0.85rem; color: var(--text-muted); margin-bottom: 24px;">
      <a href={withBase('/')} style="color: var(--text-muted);">Home</a>
      <span>/</span>
      <span style="color: var(--text-primary);">Production Handbook</span>
    </nav>

    <!-- Header Banner -->
    <div style="background: var(--bg-card); border: 1px solid var(--border-subtle); border-left: 4px solid var(--crimson-accent); border-radius: 16px; padding: 40px; margin-bottom: 40px;">
      <div class="hero-badge" style="margin-bottom: 16px;">
        <span>Documentary Grammar</span>
      </div>
      <h1 style="font-family: var(--font-display); font-size: clamp(2rem, 4vw, 3rem); font-weight: 800; color: #fff; margin-bottom: 12px;">
        Production Handbook
      </h1>
      <p style="font-size: 1.1rem; color: var(--gold-primary); font-family: var(--font-display); font-weight: 600; margin-bottom: 16px;">
        Visual Rules, Audio Architecture, and Editorial Guardrails
      </p>
      <p style="max-width: 800px; font-size: 1rem; color: var(--text-secondary); line-height: 1.7;">
        How the series shoots documents, archives, maps, and landscapes: no celebratory anthems, no aestheticized suffering or reconstructed violence, and precise labels on claims versus physical traces.
      </p>
    </div>

    <!-- Content Layout -->
    <div class="reader-layout" style="padding-top: 0;">
      <article class="reader-main prose-body" set:html={html} />

      <aside class="reader-sidebar">
        <div class="toc-card">
          <h2 class="toc-title">Handbook Sections</h2>
          {toc.length > 0 && (
            <ul class="toc-list">
              {toc.map((item) => (
                <li>
                  <a href={`#${item.id}`} class:list={['toc-link', { 'level-3': item.level === 3 }]}>
                    {item.text}
                  </a>
                </li>
              ))}
            </ul>
          )}
        </div>
      </aside>
    </div>
  </div>
</Layout>
